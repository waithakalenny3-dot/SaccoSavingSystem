<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SaccoManager</RootNamespace>
    <AssemblyName>SaccoManager</AssemblyName>
    <StartupObject>SaccoManager.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Version>1.0.0</Version>
    <Product>Sacco Savings and Loan Management System</Product>
    <Authors>SaccoManager Project</Authors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\sacco_schema.sql">
      <LogicalName>SaccoManager.sacco_schema.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
